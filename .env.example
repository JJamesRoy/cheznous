# --- Supabase (required) -----------------------------------------------------
# Project URL. Local: http://127.0.0.1:54321 (from `pnpm supabase start`).
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
# Publishable (anon) key. Safe to expose: every query is protected by RLS.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxx

# Public URL of this app (used for invitation links, OAuth resource metadata, MCP resource URL).
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Optional: URL the *server* uses to reach Supabase if different from the public one (e.g. Docker network).
# SUPABASE_INTERNAL_URL=
# Optional: issuer expected in access tokens. Default: ${NEXT_PUBLIC_SUPABASE_URL}/auth/v1
# SUPABASE_AUTH_ISSUER=

# --- MCP -----------------------------------------------------------------------
# Max tool calls per user per minute.
MCP_RATE_LIMIT_PER_MINUTE=60
# DEV ONLY. Lets an app session token (not issued via OAuth) call /api/mcp. Never true in production.
MCP_ALLOW_SESSION_TOKENS=false
# Optional comma-separated allowlist of browser Origins for /api/mcp (DNS-rebinding guard).
# MCP_ALLOWED_ORIGINS=http://localhost:6274

# --- AI budget recommendations (optional) ------------------------------------
# Claude API key (console.anthropic.com). Server-only, never exposed to the browser.
ANTHROPIC_API_KEY=
# Fallback when the Claude API call fails (credits exhausted, outage): OpenRouter key + model slug.
OPENROUTER_API_KEY=
# OPENROUTER_MODEL=anthropic/claude-opus-5.5

# --- Web Push (optional) ------------------------------------------------------
# Generate with: pnpm exec web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:toi@example.com
# Secret for the reminders cron endpoint (/api/cron/reminders).
CRON_SECRET=

# --- Dev seed / tests (never in production) -----------------------------------------
# Only used by `pnpm seed:demo`, `pnpm seed:reset` and integration tests against LOCAL Supabase.
# SUPABASE_SECRET_KEY=sb_secret_xxx
